import * as THREE from 'three';
import { COLORS } from './constants.js';
import { loadModel } from './level.js';

// CORE CIRCUIT: energy beams, mirrors and receivers.
//
//   Source    shoots a beam in a straight line along the floor grid (east, west, north or south)
//   Mirror    a diagonal panel. The beam bounces off it and turns 90 degrees.
//             ROTATE (R) flips the mirror, so the beam turns the other way.
//   Receiver  lights up when a beam reaches it, and opens the door linked to it
//
// Anything solid in the way stops the beam: cubes, blocks (SHIFT can move them), closed doors.
// There is no simulation: every frame the beam is simply followed cell by cell on the grid.
//
// Level data:
//   circuit: {
//     sources:    [{ cell: [x, y, z], dir: [dx, dz] }]   dir = which way it shoots, [1, 0] = east (+x)
//     reflectors: [{ cell: [x, y, z], state: 0 }]        state 0 turns an eastward beam south (+z), state 1 north (-z)
//     receivers:  [{ cell: [x, y, z], door: 0 }]         door = index in the level's doors list
//   }
// The cells of one beam must all be at the same height (y). They sit on the floor, one cube up.

const MAX_STEPS = 18; // a beam never travels farther than this many cells
const TURN_TIME = 0.35; // seconds a mirror takes to turn
const CORE_THICKNESS = 0.1;
const HALO_THICKNESS = 0.26;
const BEAM_CORE_COLOR = 0xc8f8ff; // the hot centre of the beam is nearly white
const HELIX_RADIUS = 0.16; // how far the spinning strands are from the middle of the beam
const BEAM_SPIN_SPEED = 1.0; // how fast the strands spin around the beam (radians per second, lower = slower)
const BEAM_TWIST = 2.5; // how tightly the strands wind around the beam (radians per cube of length)
const BEAM_PULSE_SPEED = 3.0; // how fast the bright pulses run along the beam

// ENERGY SOURCE look (model made in Blender, lives in public/models/)
const SOURCE_MODEL_URL = '/models/energy_source.glb';
const SOURCE_BEAM_START = 0.46; // the beam starts at the orange aperture, a little before the edge of the cell
const SOURCE_PULSE_SPEED = 2.5; // how fast the orange aperture pulses
const SOURCE_GLOW_SIZE = 0.6; // size of the soft glow at the aperture

// MIRROR look (model made in Blender, lives in public/models/)
const MIRROR_MODEL_URL = '/models/mirror.glb';
const MIRROR_FLARE = 2.0; // how much brighter the mirror's lights get while it turns (2 = three times as bright)
const MIRROR_GLOW_SIZE = 0.5; // size of the glow where the beam bounces

// RECEIVER look (model made in Blender, lives in public/models/)
const RECEIVER_MODEL_URL = '/models/receiver.glb';
const RECEIVER_APERTURE = 0.43; // the beam ends at the hexagonal aperture, this far from the middle of the cell
const RECEIVER_TURN_SPEED = 10; // how fast the receiver turns its face toward the beam (higher = faster)
const RECEIVER_GLOW_SIZE = 0.7; // size of the soft glow at the aperture while powered
const RECEIVER_CORE_ON = new THREE.Color().setRGB(0.423, 0.922, 1.0); // the pale cyan the hexagon fills with
const ORANGE = new THREE.Color(COLORS.orange);
const CYAN = new THREE.Color(COLORS.cyan);

const cellKey = (x, y, z) => `${x},${y},${z}`;

// How a mirror in each state turns a beam travelling in direction d = [dx, dz]
const reflectDirection = (d, state) => (state === 0 ? [d[1], d[0]] : [-d[1], -d[0]]);
// The panel's angle around the vertical axis in each state (they are 90 degrees apart)
const mirrorAngle = (state) => (state === 0 ? -Math.PI / 4 : Math.PI / 4);

// The living part of the beam: two strands that spin around it, and pulses that run along it.
// It is drawn on a see-through tube around the beam, so the beam never looks like a plain stick.
const HELIX_VERTEX = `
  varying vec2 vUv;
  void main() {
    vUv = uv;
    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
  }
`;
const HELIX_FRAGMENT = `
  uniform float uTime;
  uniform float uLength;
  uniform float uSpin;
  uniform float uTwist;
  uniform float uPulseSpeed;
  uniform vec3 uColor;
  varying vec2 vUv;
  void main() {
    float angle = vUv.x * 6.2831853;   // around the beam
    float along = vUv.y * uLength;     // distance along the beam, in cubes
    float phase = angle + along * uTwist - uTime * uSpin;
    float strands = pow(max(0.0, cos(phase)), 10.0) + pow(max(0.0, -cos(phase)), 10.0);
    float pulse = pow(0.5 + 0.5 * sin(along * 4.0 - uTime * uPulseSpeed), 6.0);
    float fade = smoothstep(0.0, 0.04, vUv.y) * smoothstep(1.0, 0.96, vUv.y); // soft ends
    float intensity = (strands * (0.55 + 0.9 * pulse) + 0.05) * fade;
    gl_FragColor = vec4(uColor * intensity, intensity);
    #include <tonemapping_fragment>
    #include <colorspace_fragment>
  }
`;

// ---------------------------------------------------------------- Source
// A soft round glow for the aperture (null when there is no screen, as in the headless playtest)
let apertureGlowTexture;
function getApertureGlowTexture() {
  if (apertureGlowTexture !== undefined) return apertureGlowTexture;
  apertureGlowTexture = null;
  if (typeof document !== 'undefined') {
    const canvas = document.createElement('canvas');
    canvas.width = 64;
    canvas.height = 64;
    const ctx = canvas.getContext('2d');
    const gradient = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
    gradient.addColorStop(0, 'rgba(255,255,255,1)');
    gradient.addColorStop(0.35, 'rgba(255,255,255,0.45)');
    gradient.addColorStop(1, 'rgba(255,255,255,0)');
    ctx.fillStyle = gradient;
    ctx.fillRect(0, 0, 64, 64);
    apertureGlowTexture = new THREE.CanvasTexture(canvas);
    apertureGlowTexture.colorSpace = THREE.SRGBColorSpace;
  }
  return apertureGlowTexture;
}

class EnergySource {
  constructor(scene, level, { cell, dir }) {
    this.cell = cell;
    this.dir = dir;
    level.addCollision(...cell); // CUBIT cannot walk through it

    this.group = new THREE.Group();
    this.group.position.set(...cell);
    scene.add(this.group);

    // Placeholder box with an orange nozzle, shown until the Blender model has loaded (kept if loading fails)
    this.placeholder = new THREE.Group();
    const body = new THREE.Mesh(
      new THREE.BoxGeometry(0.9, 0.9, 0.9),
      new THREE.MeshStandardMaterial({ color: COLORS.blue })
    );
    this.placeholder.add(body);
    const alongX = dir[0] !== 0;
    const nozzle = new THREE.Mesh(
      new THREE.BoxGeometry(alongX ? 0.16 : 0.42, 0.42, alongX ? 0.42 : 0.16),
      new THREE.MeshStandardMaterial({ color: COLORS.orange, emissive: COLORS.orange, emissiveIntensity: 1.4 })
    );
    nozzle.position.set(dir[0] * 0.46, 0, dir[1] * 0.46);
    this.placeholder.add(nozzle);
    this.group.add(this.placeholder);

    this.orangeMaterials = []; // the orange aperture and slots, they pulse
    this.glow = null;

    loadModel(SOURCE_MODEL_URL)
      .then((source) => this.useModel(source))
      .catch((error) => {
        console.warn('Could not load the energy source model, keeping the placeholder.', error);
      });
  }

  // Swaps the placeholder for the real source (GLB from Blender)
  useModel(source) {
    const model = source.clone(true); // shares geometry, so it is cheap

    // Every source gets its own copy of the materials
    const copies = new Map();
    model.traverse((object) => {
      if (!object.isMesh) return;
      if (!copies.has(object.material)) {
        const copy = object.material.clone();
        copies.set(object.material, copy);
        if (copy.name === 'Source_Orange') this.orangeMaterials.push(copy);
      }
      object.material = copies.get(object.material);
    });

    model.position.y = -0.5; // the model's bottom is on the floor, 0.5 below the middle of the cell
    model.rotation.y = Math.atan2(-this.dir[1], this.dir[0]); // the model shoots along +x, turn it to this source's direction

    this.group.remove(this.placeholder);
    this.placeholder.traverse((object) => {
      if (!object.isMesh) return;
      object.geometry.dispose();
      object.material.dispose();
    });
    this.group.add(model);

    // Soft glow where the beam leaves the aperture
    const texture = getApertureGlowTexture();
    if (texture) {
      this.glow = new THREE.Sprite(
        new THREE.SpriteMaterial({
          map: texture,
          color: CYAN,
          transparent: true,
          opacity: 0.8,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
        })
      );
      this.glow.scale.set(SOURCE_GLOW_SIZE, SOURCE_GLOW_SIZE, 1);
      this.glow.position.set(this.dir[0] * SOURCE_BEAM_START, 0, this.dir[1] * SOURCE_BEAM_START);
      this.group.add(this.glow);
    }
  }

  // The aperture pulses slowly, like it is charging
  update(elapsed) {
    const pulse = Math.sin(elapsed * SOURCE_PULSE_SPEED);
    for (const material of this.orangeMaterials) material.emissiveIntensity = 1.2 + 0.5 * pulse;
    if (this.glow) this.glow.material.opacity = 0.7 + 0.2 * pulse;
  }
}

// ---------------------------------------------------------------- Mirror (rotatable)
class Reflector {
  constructor(scene, level, { cell, state = 0 }) {
    this.kind = 'rotate'; // CUBIT turns it with ROTATE, like any other rotatable thing
    this.cell = cell;
    this.startState = state;
    this.state = state;
    this.moving = false;
    this.t = 0;
    this.fromAngle = 0;
    this.toAngle = 0;
    this.flare = 0; // 0 to 1: how much the lights flare up while the mirror turns
    this.glowAmount = 0; // 0 to 1: the glow where the beam bounces
    this.center = new THREE.Vector3(...cell);
    level.addCollision(...cell);

    this.group = new THREE.Group();
    this.group.position.set(...cell);
    scene.add(this.group);

    // Placeholder (flat base and a glass panel), shown until the Blender model has loaded (kept if loading fails)
    this.placeholder = new THREE.Group();
    const base = new THREE.Mesh(
      new THREE.BoxGeometry(0.9, 0.2, 0.9),
      new THREE.MeshStandardMaterial({ color: COLORS.blue })
    );
    base.position.y = -0.4;
    this.placeholder.add(base);

    const panelGeometry = new THREE.BoxGeometry(0.95, 0.9, 0.06);
    this.panel = new THREE.Mesh(
      panelGeometry,
      new THREE.MeshStandardMaterial({
        color: COLORS.cyan,
        emissive: COLORS.cyan,
        emissiveIntensity: 0.6,
        transparent: true,
        opacity: 0.55,
      })
    );
    this.panel.position.y = 0.05;
    this.panel.add(new THREE.LineSegments(new THREE.EdgesGeometry(panelGeometry), new THREE.LineBasicMaterial({ color: COLORS.cyan })));
    this.placeholder.add(this.panel);
    this.group.add(this.placeholder);

    this.turning = this.panel; // the part that turns (later: the whole top of the model)
    this.lightMaterials = []; // the cyan lights and the glass, they flare while the mirror turns
    this.glow = null;

    this.applyState();

    loadModel(MIRROR_MODEL_URL)
      .then((source) => this.useModel(source))
      .catch((error) => {
        console.warn('Could not load the mirror model, keeping the placeholder.', error);
      });
  }

  // Swaps the placeholder for the real mirror (GLB from Blender)
  useModel(source) {
    const model = source.clone(true); // shares geometry, so it is cheap
    const head = model.getObjectByName('Mirror_Head'); // turntable, frame and glass: the part that turns
    if (!head) throw new Error('mirror.glb needs a part called Mirror_Head');

    // Every mirror gets its own copy of the materials
    const copies = new Map();
    model.traverse((object) => {
      if (!object.isMesh) return;
      if (!copies.has(object.material)) {
        const copy = object.material.clone();
        copies.set(object.material, copy);
        if (['Mirror_Cyan', 'Mirror_Glass', 'Mirror_Shine'].includes(copy.name)) {
          this.lightMaterials.push({ material: copy, base: copy.emissiveIntensity });
        }
      }
      object.material = copies.get(object.material);
    });

    model.position.y = -0.5; // the model's bottom is on the floor, 0.5 below the middle of the cell
    this.group.remove(this.placeholder);
    this.placeholder.traverse((object) => {
      if (object.geometry) object.geometry.dispose();
      if (object.material) object.material.dispose();
    });
    this.group.add(model);

    this.turning = head;
    // Soft glow at the bounce point (shown while the beam hits the mirror)
    const texture = getApertureGlowTexture();
    if (texture) {
      this.glow = new THREE.Sprite(
        new THREE.SpriteMaterial({
          map: texture,
          color: CYAN,
          transparent: true,
          opacity: 0,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
        })
      );
      this.glow.scale.set(MIRROR_GLOW_SIZE, MIRROR_GLOW_SIZE, 1);
      this.glow.visible = false;
      this.group.add(this.glow);
    }

    this.applyState();
    this.applyLook();
  }

  applyState() {
    this.turning.rotation.y = mirrorAngle(this.state);
  }

  // The lights flare up while the mirror turns, then settle
  applyLook() {
    for (const { material, base } of this.lightMaterials) {
      material.emissiveIntensity = base * (1 + MIRROR_FLARE * this.flare);
    }
  }

  // Called every frame by the circuit: is the beam bouncing off this mirror right now?
  setHit(hit, elapsed) {
    if (!this.glow) return;
    this.glowAmount += ((hit ? 1 : 0) - this.glowAmount) * 0.2;
    this.glow.visible = this.glowAmount > 0.01;
    this.glow.material.opacity = this.glowAmount * (0.6 + 0.15 * Math.sin(elapsed * 6));
  }

  reflect(direction) {
    return reflectDirection(direction, this.state);
  }

  distanceTo(point) {
    return this.center.distanceTo(point);
  }

  canActivate() {
    return !this.moving;
  }

  activate() {
    this.fromAngle = mirrorAngle(this.state);
    this.state = 1 - this.state;
    this.toAngle = mirrorAngle(this.state);
    this.t = 0;
    this.moving = true;
  }

  update(delta) {
    if (!this.moving) {
      if (this.flare !== 0) {
        this.flare = 0;
        this.applyLook();
      }
      return;
    }
    this.t = Math.min(1, this.t + delta / TURN_TIME);
    const eased = this.t * this.t * (3 - 2 * this.t);
    this.turning.rotation.y = THREE.MathUtils.lerp(this.fromAngle, this.toAngle, eased);
    this.flare = Math.sin(Math.PI * this.t); // strongest in the middle of the turn
    this.applyLook();
    if (this.t >= 1) this.moving = false;
  }

  reset() {
    this.state = this.startState;
    this.moving = false;
    this.t = 0;
    this.flare = 0;
    this.applyState();
    this.applyLook();
  }
}

// ---------------------------------------------------------------- Receiver
// The receiver has a front (the hexagonal aperture where the beam ends) and a plain back.
// It turns its front toward the beam, so it always looks right.
const yawFor = (direction) => Math.atan2(-direction[1], direction[0]); // the model's front is +x

class EnergyReceiver {
  constructor(scene, level, { cell, door, facing = null }) {
    this.cell = cell;
    this.door = door;
    this.powered = false;
    this.blend = 0; // 0 = waiting, 1 = powered
    level.addCollision(...cell);

    // Optional in the level data: facing: [dx, dz] forces the direction the front looks
    this.facingGiven = facing !== null;
    this.yaw = yawFor(facing ?? [0, 1]);
    this.targetYaw = this.yaw;

    this.group = new THREE.Group();
    this.group.position.set(...cell);
    scene.add(this.group);

    this.turner = new THREE.Group(); // turns the whole receiver toward the beam
    this.turner.rotation.y = this.yaw;
    this.group.add(this.turner);

    // Placeholder box with glowing pads, shown until the Blender model has loaded (kept if loading fails)
    this.placeholder = new THREE.Group();
    const bodyGeometry = new THREE.BoxGeometry(0.9, 0.9, 0.9);
    const body = new THREE.Mesh(bodyGeometry, new THREE.MeshStandardMaterial({ color: COLORS.navy }));
    this.placeholder.add(body);

    this.edgeMaterial = new THREE.LineBasicMaterial({ color: COLORS.orange });
    body.add(new THREE.LineSegments(new THREE.EdgesGeometry(bodyGeometry), this.edgeMaterial));

    // A glowing pad on each side: orange while it waits for energy, cyan when it has it
    this.padMaterial = new THREE.MeshStandardMaterial({
      color: COLORS.orange,
      emissive: COLORS.orange,
      emissiveIntensity: 0.9,
    });
    for (const [sx, sz] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {
      const pad = new THREE.Mesh(
        new THREE.BoxGeometry(sx ? 0.06 : 0.46, 0.46, sx ? 0.46 : 0.06),
        this.padMaterial
      );
      pad.position.set(sx * 0.46, 0, sz * 0.46);
      this.placeholder.add(pad);
    }
    this.turner.add(this.placeholder);

    // Filled in when the model has loaded
    this.model = null;
    this.coreMaterial = null; // the hexagon in the aperture: dark while waiting, fills with cyan when powered
    this.cyanMaterial = null; // the neon rim and the slots
    this.orangeMaterial = null; // the slits on the base: orange while waiting, cyan when powered
    this.cyanBase = 1;
    this.orangeBase = 1;
    this.rays = null; // three ray ticks above the housing, hidden until powered
    this.glow = null;

    loadModel(RECEIVER_MODEL_URL)
      .then((source) => this.useModel(source))
      .catch((error) => {
        console.warn('Could not load the receiver model, keeping the placeholder.', error);
      });
  }

  // Swaps the placeholder for the real receiver (GLB from Blender)
  useModel(source) {
    const model = source.clone(true); // shares geometry, so it is cheap
    const rays = model.getObjectByName('Receiver_Rays');
    if (!rays) throw new Error('receiver.glb needs a part called Receiver_Rays');

    // Every receiver gets its own copy of the materials, so each one can light up on its own
    const copies = new Map();
    model.traverse((object) => {
      if (!object.isMesh) return;
      if (!copies.has(object.material)) {
        const copy = object.material.clone();
        copies.set(object.material, copy);
        if (copy.name === 'Receiver_Core') this.coreMaterial = copy;
        if (copy.name === 'Receiver_Cyan') this.cyanMaterial = copy;
        if (copy.name === 'Receiver_Orange') this.orangeMaterial = copy;
      }
      object.material = copies.get(object.material);
    });
    this.cyanBase = this.cyanMaterial ? this.cyanMaterial.emissiveIntensity : 1;
    this.orangeBase = this.orangeMaterial ? this.orangeMaterial.emissiveIntensity : 1;

    model.position.y = -0.5; // the model's bottom is on the floor, 0.5 below the middle of the cell

    this.turner.remove(this.placeholder);
    this.placeholder.traverse((object) => {
      if (object.geometry) object.geometry.dispose();
      if (object.material && !object.material.isLineBasicMaterial) object.material.dispose();
    });
    this.turner.add(model);
    this.model = model;

    this.rays = rays;
    this.rays.scale.setScalar(0.001);

    // Soft glow at the aperture while powered
    const texture = getApertureGlowTexture();
    if (texture) {
      this.glow = new THREE.Sprite(
        new THREE.SpriteMaterial({
          map: texture,
          color: CYAN,
          transparent: true,
          opacity: 0,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
        })
      );
      this.glow.scale.set(RECEIVER_GLOW_SIZE, RECEIVER_GLOW_SIZE, 1);
      this.glow.position.set(RECEIVER_APERTURE + 0.04, 0, 0);
      this.glow.visible = false;
      this.turner.add(this.glow);
    }

    this.applyLook(0);
  }

  // Which way the front looks: direction = [dx, dz]. instant = no turning animation.
  setFacing(direction, instant = false) {
    this.targetYaw = yawFor(direction);
    if (instant) {
      this.yaw = this.targetYaw;
      this.turner.rotation.y = this.yaw;
    }
  }

  // The whole look of the receiver for the current blend (0 = waiting, 1 = powered)
  applyLook(elapsed) {
    const blend = this.blend;

    // placeholder pads
    this.padMaterial.color.copy(ORANGE).lerp(CYAN, blend);
    this.padMaterial.emissive.copy(ORANGE).lerp(CYAN, blend);
    this.padMaterial.emissiveIntensity = 0.9 + 1.0 * blend;
    this.edgeMaterial.color.copy(ORANGE).lerp(CYAN, blend);

    if (!this.model) return;

    if (this.coreMaterial) {
      // dark hole while waiting, bright pale cyan with a gentle pulse when powered
      this.coreMaterial.emissive.copy(CYAN).lerp(RECEIVER_CORE_ON, blend);
      this.coreMaterial.emissiveIntensity = 0.04 + blend * (2.4 + 0.4 * Math.sin(elapsed * 5));
    }
    if (this.cyanMaterial) this.cyanMaterial.emissiveIntensity = this.cyanBase * (1 + 1.2 * blend);
    if (this.orangeMaterial) {
      // the game's language: orange = waiting, cyan = done
      this.orangeMaterial.emissive.copy(ORANGE).lerp(CYAN, blend);
      this.orangeMaterial.emissiveIntensity = this.orangeBase * (1 + 0.6 * blend);
    }
    if (this.rays) {
      this.rays.scale.setScalar(blend < 0.02 ? 0.001 : blend * (1 + 0.08 * Math.sin(elapsed * 9)));
    }
    if (this.glow) {
      this.glow.visible = blend > 0.02;
      this.glow.material.opacity = blend * (0.7 + 0.15 * Math.sin(elapsed * 6));
    }
  }

  update(delta, elapsed) {
    // turn toward the beam, the short way round
    const diff = THREE.MathUtils.euclideanModulo(this.targetYaw - this.yaw + Math.PI, Math.PI * 2) - Math.PI;
    this.yaw += diff * Math.min(1, RECEIVER_TURN_SPEED * delta);
    this.turner.rotation.y = this.yaw;

    const target = this.powered ? 1 : 0;
    this.blend += (target - this.blend) * Math.min(1, 12 * delta);
    this.applyLook(elapsed);
  }
}

// ---------------------------------------------------------------- The whole circuit of a level
export class CircuitManager {
  constructor(scene, level, data) {
    const circuit = data.circuit ?? {};
    this.level = level;

    this.sources = (circuit.sources ?? []).map((s) => new EnergySource(scene, level, s));
    this.reflectors = (circuit.reflectors ?? []).map((r) => new Reflector(scene, level, r));
    this.receivers = (circuit.receivers ?? []).map((r) => new EnergyReceiver(scene, level, r));

    this.reflectorAt = new Map(this.reflectors.map((r) => [cellKey(...r.cell), r]));
    this.receiverAt = new Map(this.receivers.map((r) => [cellKey(...r.cell), r]));

    // Before any beam arrives, a receiver faces the mirror or source that can feed it
    for (const receiver of this.receivers) {
      if (!receiver.facingGiven) receiver.setFacing(this.guessFacing(receiver), true);
    }

    // Beams are drawn as thin glowing boxes. They are rebuilt only when the beam path changes.
    this.beamGroup = new THREE.Group();
    scene.add(this.beamGroup);
    this.boxGeometry = new THREE.BoxGeometry(1, 1, 1);
    this.coreMaterial = new THREE.MeshBasicMaterial({ color: BEAM_CORE_COLOR, transparent: true, opacity: 0.95 });
    this.haloMaterial = new THREE.MeshBasicMaterial({
      color: COLORS.cyan,
      transparent: true,
      opacity: 0.18,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
    });
    this.helixGeometry = new THREE.CylinderGeometry(1, 1, 1, 24, 1, true); // unit tube, scaled per beam piece
    this.timeUniform = { value: 0 }; // shared by every beam piece
    this.signature = '';
  }

  // Looks along the four directions from a receiver and returns the way to the nearest mirror,
  // or to a source that shoots toward it. That is the way its front should look.
  guessFacing(receiver) {
    const [x, y, z] = receiver.cell;
    let best = null;
    let bestDistance = Infinity;
    for (const d of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {
      for (let step = 1; step <= MAX_STEPS; step++) {
        const cx = x + d[0] * step;
        const cz = z + d[1] * step;
        if (this.reflectorAt.has(cellKey(cx, y, cz))) {
          if (step < bestDistance) {
            best = d;
            bestDistance = step;
          }
          break;
        }
        const source = this.sources.find((s) => s.cell[0] === cx && s.cell[1] === y && s.cell[2] === cz);
        if (source) {
          if (source.dir[0] === -d[0] && source.dir[1] === -d[1] && step < bestDistance) {
            best = d;
            bestDistance = step;
          }
          break;
        }
        if (this.level.isSolid(cx, y, cz)) break;
      }
    }
    return best ?? [0, 1];
  }

  // The see-through spinning strands for one straight piece of beam
  makeHelixMaterial(length) {
    return new THREE.ShaderMaterial({
      uniforms: {
        uTime: this.timeUniform,
        uLength: { value: length },
        uSpin: { value: BEAM_SPIN_SPEED },
        uTwist: { value: BEAM_TWIST },
        uPulseSpeed: { value: BEAM_PULSE_SPEED },
        uColor: { value: CYAN.clone() },
      },
      vertexShader: HELIX_VERTEX,
      fragmentShader: HELIX_FRAGMENT,
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      side: THREE.DoubleSide,
    });
  }

  // Follows every beam cell by cell. Returns its straight pieces [y, x0, z0, x1, z1]
  // and the set of receivers that a beam reaches.
  trace() {
    const segments = [];
    const powered = new Set();
    const arrivals = new Map(); // which way the beam was travelling when it reached a receiver
    const hit = new Set(); // mirrors that a beam is bouncing off right now

    for (const source of this.sources) {
      const y = source.cell[1];
      let d = source.dir;
      let cx = source.cell[0];
      let cz = source.cell[2];
      let start = [cx + d[0] * SOURCE_BEAM_START, cz + d[1] * SOURCE_BEAM_START]; // leaves through the aperture of the source
      let ended = false;

      for (let step = 0; step < MAX_STEPS && !ended; step++) {
        cx += d[0];
        cz += d[1];
        const faceX = cx - d[0] * 0.5; // the near face of this cell
        const faceZ = cz - d[1] * 0.5;
        const key = cellKey(cx, y, cz);

        const reflector = this.reflectorAt.get(key);
        if (reflector) {
          if (reflector.moving) {
            // the beam is cut while the mirror turns
            segments.push([y, start[0], start[1], faceX, faceZ]);
            ended = true;
          } else {
            segments.push([y, start[0], start[1], cx, cz]);
            hit.add(reflector);
            d = reflector.reflect(d);
            start = [cx, cz];
          }
          continue;
        }

        const receiver = this.receiverAt.get(key);
        if (receiver) {
          // the beam ends at the receiver's aperture, which turns to face it
          segments.push([y, start[0], start[1], cx - d[0] * RECEIVER_APERTURE, cz - d[1] * RECEIVER_APERTURE]);
          powered.add(receiver);
          arrivals.set(receiver, d);
          ended = true;
        } else if (this.level.isSolid(cx, y, cz)) {
          segments.push([y, start[0], start[1], faceX, faceZ]);
          ended = true;
        } else if (step === MAX_STEPS - 1) {
          segments.push([y, start[0], start[1], cx, cz]);
          ended = true;
        }
      }
    }
    return { segments, powered, hit, arrivals };
  }

  rebuildBeams(segments) {
    for (const mesh of this.beamGroup.children) {
      if (mesh.userData.ownsMaterial) mesh.material.dispose();
    }
    this.beamGroup.clear();
    for (const [y, x0, z0, x1, z1] of segments) {
      const alongX = Math.abs(x1 - x0) > Math.abs(z1 - z0);
      const length = (alongX ? Math.abs(x1 - x0) : Math.abs(z1 - z0)) + CORE_THICKNESS; // a little extra fills the corners
      for (const [thickness, material] of [
        [CORE_THICKNESS, this.coreMaterial],
        [HALO_THICKNESS, this.haloMaterial],
      ]) {
        const mesh = new THREE.Mesh(this.boxGeometry, material);
        const long = length + (thickness - CORE_THICKNESS);
        mesh.scale.set(alongX ? long : thickness, thickness, alongX ? thickness : long);
        mesh.position.set((x0 + x1) / 2, y, (z0 + z1) / 2);
        this.beamGroup.add(mesh);
      }

      // Two strands spinning around the beam, with pulses running from the source outwards
      const travel = (alongX ? Math.sign(x1 - x0) : Math.sign(z1 - z0)) || 1; // which way the energy flows
      const helix = new THREE.Mesh(this.helixGeometry, this.makeHelixMaterial(length));
      helix.userData.ownsMaterial = true;
      helix.scale.set(HELIX_RADIUS, length, HELIX_RADIUS);
      if (alongX) helix.rotation.z = -travel * (Math.PI / 2); // the tube's own axis points the way the energy flows
      else helix.rotation.x = travel * (Math.PI / 2);
      helix.position.set((x0 + x1) / 2, y, (z0 + z1) / 2);
      this.beamGroup.add(helix);
    }
  }

  // Returns [{ door, powered }] for the mechanisms, so receivers can open doors
  update(delta, elapsed) {
    const { segments, powered, hit, arrivals } = this.trace();

    const signature = segments.map((s) => s.join(',')).join('|');
    if (signature !== this.signature) {
      this.signature = signature;
      this.rebuildBeams(segments);
    }
    this.haloMaterial.opacity = 0.16 + 0.06 * Math.sin(elapsed * 8);
    this.coreMaterial.opacity = 0.9 + 0.05 * Math.sin(elapsed * 11); // the hot core flickers a little
    this.timeUniform.value = elapsed; // drives the spinning strands and the pulses
    for (const source of this.sources) source.update(elapsed);
    for (const reflector of this.reflectors) reflector.setHit(hit.has(reflector), elapsed);

    for (const receiver of this.receivers) {
      receiver.powered = powered.has(receiver);
      const arrival = arrivals.get(receiver);
      if (arrival) receiver.setFacing([-arrival[0], -arrival[1]]); // turn the front toward the beam
      receiver.update(delta, elapsed);
    }
    return this.receivers.map((r) => ({ door: r.door, powered: r.powered }));
  }
}
